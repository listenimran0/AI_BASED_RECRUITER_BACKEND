{
  "name": "recruiter-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API and background workers for the AI recruiting co-worker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "reset:db": "tsx scripts/reset-db.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^6.5.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "openai": "^7.47.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
