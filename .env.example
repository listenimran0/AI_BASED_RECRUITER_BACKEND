# Server
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/recruiter
REDIS_URL=redis://127.0.0.1:6379

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# LLM (any OpenAI compatible endpoint). Leave the key empty to run on built-in fallbacks.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# USD per 1M tokens
LLM_PRICE_IN=0.15
LLM_PRICE_OUT=0.6

SCORING_CONCURRENCY=5
DRAFTING_CONCURRENCY=3

# Candidate search (https://serper.dev). Empty uses the sample fixture in seed/.
SERPER_API_KEY=

# Recruiter details and limits
RECRUITER_NAME=
COMPANY_NAME=
DAILY_SEND_LIMIT=20

# Follow-up timing: one "day" between steps and how often due emails are picked up
OUTREACH_DAY_MS=86400000
SWEEP_EVERY_MS=10000

CALENDLY_URL=

# Email. Empty SMTP_HOST means messages are built but not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Recruiting Team <recruiting@example.test>
